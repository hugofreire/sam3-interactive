# GPU Server Configuration - SAM3 HTTP Service Only
# Runs standalone FastAPI service for remote SAM3 inference

# SAM3 HTTP Service
SAM3_HTTP_HOST=0.0.0.0
SAM3_HTTP_PORT=8000

# GPU Configuration
CUDA_VISIBLE_DEVICES=1

# Optional: Training (if also running training jobs)
TRAINING_DEVICE=1
TRAINING_WORKERS=4
