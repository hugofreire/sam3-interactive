# Backend server
PORT=3001
# Use absolute paths for data if running outside the repo root
DATA_ROOT=./backend/datasets
UPLOADS_DIR=./backend/uploads
EXPORTS_DIR=./backend/exports
SAM3_PYTHON=python3
# Set to '' or omit to run on CPU (e.g., Raspberry Pi)
SAM3_CUDA_VISIBLE_DEVICES=1
SAM3_DEVICE=

# Training defaults
TRAIN_DEVICE=1
TRAIN_CUDA_VISIBLE_DEVICES=1
TRAIN_WORKERS=4
TRAIN_MODEL=yolo11n
TRAIN_BATCH=8
TRAIN_EPOCHS=100
TRAIN_IMGSZ=640

# Frontend dev server + API wiring
VITE_PORT=5173
VITE_API_URL=http://localhost:3001
VITE_PROXY_TARGET=http://localhost:3001

# Optional LLM agent support
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
