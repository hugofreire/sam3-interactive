# Backend server
PORT=3001
HOST=127.0.0.1
# Use absolute paths for data if running outside the repo root
DATA_ROOT=./backend/datasets
UPLOADS_DIR=./backend/uploads
EXPORTS_DIR=./backend/exports
SAM3_PYTHON=python3
# Set to '' or omit to run on CPU (e.g., Raspberry Pi)
SAM3_CUDA_VISIBLE_DEVICES=1
SAM3_DEVICE=

# SAM3 Remote Service (optional)
# If set, backend uses HTTP client instead of local subprocess
# Use this on Raspberry Pi to offload SAM3 to a GPU server
# SAM3_REMOTE_URL=http://10.9.0.14:8000

# SAM3 HTTP Service (for GPU server standalone mode)
# SAM3_HTTP_HOST=0.0.0.0
# SAM3_HTTP_PORT=8000

# Training defaults
TRAIN_DEVICE=1
TRAIN_CUDA_VISIBLE_DEVICES=1
TRAIN_WORKERS=4
TRAIN_MODEL=yolo11n
TRAIN_BATCH=8
TRAIN_EPOCHS=100
TRAIN_IMGSZ=640

# Frontend dev server + API wiring
VITE_PORT=5173
VITE_API_URL=http://localhost:3001
VITE_PROXY_TARGET=http://localhost:3001

# Optional LLM agent support
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
